# 生产环境配置
VITE_APP_ENV = 'production'

# 应用标题
VITE_APP_TITLE = 'D-Space DigiSmart'

# 正式环境后端API地址
VITE_APP_BASE_API = 'http://config-admin-api.riding-evolved.com'
# VITE_APP_BASE_API = 'http://test-admin.riding-evolved.com'
# VITE_APP_BASE_API = 'http://192.168.2.20:8111'
# MQTT设备服务器地址
VITE_APP_MQTT_HOST = 'http://pucs.riding-evolved.com'
#  VITE_APP_MQTT_HOST = 'http://test-pucs.riding-evolved.com'

# MQTT设备类型配置
VITE_APP_DEVICE_TYPE = 'DIGIWISE_CLOUD_DESKTOP'
VITE_APP_DEVICE_TYPE_CODE = 8

# 迪太云网页地址
VITE_APP_DIGI_CLOUD_URL = 'http://cloud.riding-evolved.com/digiSmart/redirect'
# VITE_APP_DIGI_CLOUD_URL = 'http://test-cloud.riding-evolved.com/digiSmart/redirect'

# 文档与流程管理平台地址
# VITE_DOCUMENT_PROCESS_URL = 'http://cloud.riding-evolved.com/document-v3/#/home'
VITE_DOCUMENT_PROCESS_URL = 'http://cloud.riding-evolved.com/document-v3/#/home'
